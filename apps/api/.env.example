# Copia in apps/api/.env. Non committare mai il file .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Voce maschile AI
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Facoltativo: archivio privato (per esempio /path/memory-dir)
# JARVIS_DATA_DIR=

# Google Calendar: client OAuth di tipo Applicazione web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
